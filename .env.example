APP_NAME=AI Resume Analyzer
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://resume_app:replace_with_a_strong_password@127.0.0.1:3306/resume_analyzer
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_REQUEST_TIMEOUT_SECONDS=60
MAX_FILE_SIZE_MB=5
MAX_PDF_PAGES=100
MAX_TOOL_CALL_ROUNDS=5
STORE_SOURCE_TEXT=false
RATE_LIMIT_ANALYSIS=10/minute
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_STORAGE_URI=memory://
